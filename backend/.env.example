# 复制为 backend/.env 后填写；.env 已在 .gitignore 里，不会进 git
SUPABASE_URL=https://ncfyrpxfbiunsjsmecax.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<Dashboard → Project Settings → API → service_role>
# 二选一：项目用旧版 HS256 就填 JWT secret；用新版非对称签名则留空走 JWKS
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# 允许跨域的前端来源（逗号分隔）。前端换端口或上线后必须同步修改，
# 否则浏览器预检 OPTIONS 会返回 400 Disallowed CORS origin。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,null

# 可选：单文件 PDF 上限（字节）与签名 URL 有效期（秒）
# MAX_PDF_BYTES=20971520
# SIGNED_URL_TTL=60
