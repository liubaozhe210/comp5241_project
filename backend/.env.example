# 复制为 backend/.env 后填写；.env 已在 .gitignore 里，不会进 git
# 本文件只放占位符：任何真实密码 / key 都不要写在这里

# ---- 业务数据库（MySQL）----
# 口令里有 @ : / 等特殊字符时必须做 URL 编码，例如 @ → %40
DATABASE_URL=mysql+pymysql://<用户名>:<密码>@<主机>:3306/<数据库名>

# ---- 认证（自托管 JWT，HS256）----
# 随机字符串即可：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<随机密钥>

# ---- 课件存储（本地磁盘）----
# 相对 backend/ 或绝对路径；默认 data/materials（已 gitignore）
# MATERIALS_DIR=data/materials

# 允许跨域的前端来源（逗号分隔）。前端换端口或上线后必须同步修改，
# 否则浏览器预检 OPTIONS 会返回 400 Disallowed CORS origin。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3310,http://127.0.0.1:3310,null

# 可选：单文件 PDF 上限（字节）与下载 URL 有效期（秒）
# MAX_PDF_BYTES=20971520
# SIGNED_URL_TTL=60

# 可选：连接池（阿里云会掐空闲连接，pool_recycle 要小于 wait_timeout）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_ECHO=false

# PDF 互动课程：支持 JSON mode 的 Chat Completions 兼容服务
# BASE_URL 填 API 根地址（通常以 /v1 结尾），不要包含 /chat/completions
COURSE_AI_BASE_URL=https://openrouter.ai/api/v1
COURSE_AI_API_KEY=
COURSE_AI_MODEL=openai/gpt-4o

# Output budget includes reasoning tokens; retain 3500 for the paid model above.
COURSE_AI_MAX_TOKENS=3500
# Free reasoning model alternative (set BOTH values together):
# COURSE_AI_MODEL=baidu/ernie-5.5-flash-preview:free
# COURSE_AI_MAX_TOKENS=16384

# Optional: real AI plan generation. Configure only on the backend.
# Compatible chat-completions endpoint; include the full /chat/completions path.
# AI_GENERATION_ENABLED=true
# AI_CHAT_COMPLETIONS_URL=https://<provider-host>/v1/chat/completions
# AI_API_KEY=<server-side API key>
# AI_MODEL=<provider model identifier>
# AI_TIMEOUT_SECONDS=60

# Interview Mastery; isolated OpenRouter settings, server-side only.
# OPENROUTER_API_KEY=<server-side API key>
# OPENROUTER_MODEL=<OpenRouter model identifier>
# Optional vision model for OCR fallback when PDF text cannot be decoded.
OPENROUTER_OCR_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=90
# OPENROUTER_APP_NAME=CourseHub Interview Mastery
# OPENROUTER_SITE_URL=http://localhost:3000
