# 复制为 backend/.env 后填写；.env 已在 .gitignore 里，不会进 git
# 本文件只放占位符：任何真实密码 / key 都不要写在这里

# ---- 业务数据库（MySQL）----
# 口令里有 @ : / 等特殊字符时必须做 URL 编码，例如 @ → %40
DATABASE_URL=mysql+pymysql://<用户名>:<密码>@<主机>:3306/<数据库名>

# ---- Supabase：仅用于 Auth（登录 / 建号 / 重置密码）与 Storage（课件文件）----
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<你的 service_role / secret key>
# 二选一：项目用旧版 HS256 就填 JWT secret；用新版非对称签名则留空走 JWKS
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# 允许跨域的前端来源（逗号分隔）。前端换端口或上线后必须同步修改，
# 否则浏览器预检 OPTIONS 会返回 400 Disallowed CORS origin。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,null

# 可选：单文件 PDF 上限（字节）与签名 URL 有效期（秒）
# MAX_PDF_BYTES=20971520
# SIGNED_URL_TTL=60

# 可选：连接池（阿里云会掐空闲连接，pool_recycle 要小于 wait_timeout）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_ECHO=false

# PDF 互动课程：支持 JSON mode 的 Chat Completions 兼容服务
# BASE_URL 填 API 根地址（通常以 /v1 结尾），不要包含 /chat/completions
COURSE_AI_BASE_URL=
COURSE_AI_API_KEY=
COURSE_AI_MODEL=
